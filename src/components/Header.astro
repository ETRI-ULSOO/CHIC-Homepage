---
import LangSwitch from './LangSwitch.astro';
import { withBase } from '../lib/url';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const nav = [
  { href: withBase(`/${locale}/#project`), label: t('nav.project') },
  { href: withBase(`/${locale}/results/`), label: t('nav.results') },
  { href: withBase(`/${locale}/publications/`), label: t('nav.publications') },
  { href: withBase(`/${locale}/#consortium`), label: t('nav.consortium') },
  { href: withBase(`/${locale}/news/`), label: t('nav.news') },
  { href: withBase(`/${locale}/#contact`), label: t('nav.contact') },
];
---

<header>
  <div class="wrap bar">
    <a class="mark" href={withBase(`/${locale}/`)}>CHIC</a>
    <nav aria-label="주 메뉴">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <LangSwitch />
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--c-border);
    background: var(--c-canvas);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-24);
    padding-block: var(--s-16);
  }
  /* 워드마크는 브랜드 요소다. 내비(15px) 대비 확실히 커야 위계가 선다. */
  .mark {
    font-family: var(--f-serif-en);
    /* Cormorant는 획이 가늘다 — 다크 배경에서 600이 아니면 획이 사라진다 */
    font-weight: 600;
    font-size: var(--t-heading);
    line-height: 1;
    letter-spacing: 0.07em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--s-24);
    flex-wrap: wrap;
  }
  /* Ghost Link — 텍스트만, 배경 없음, hover에서만 강조 (DESIGN.md) */
  nav a {
    font-size: var(--t-body-sm);
    color: var(--c-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .bar { flex-direction: column; align-items: flex-start; }
  }
</style>
