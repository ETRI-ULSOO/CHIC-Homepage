---
import { getLocale, useTranslations, alternatePath, otherLocale } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const other = otherLocale(locale);
---

<a class="lang" href={alternatePath(Astro.url, other)} lang={other} hreflang={other}>
  {t('lang.switch')}
</a>

<style>
  .lang {
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: var(--c-text);
    text-decoration: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
  }
  /* 반대 언어가 한글일 때(영문 페이지의 '한국어') 대문자·자간을 끈다 —
     한글에는 대문자가 없고 자간만 남아 어절이 흩어진다. */
  .lang:lang(ko) {
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .lang:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }
</style>
