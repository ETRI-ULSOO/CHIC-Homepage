---
/**
 * DiagramShell — HTML 도해의 공통 껍데기.
 *
 * 종전 도해는 1280px 좌표계 SVG였다. 컨테이너가 좁으면 그 배율만큼 글자가 함께 줄어
 * 모바일에서 라벨이 2.67px까지 내려갔고, 가로 스크롤로 판독은 살렸으나 한 번에 보이는
 * 범위가 25%로 떨어져 '한눈에 보는' 도해의 본래 가치를 잃었다.
 *
 * HTML은 축소가 아니라 재배치로 좁은 폭에 대응한다. 덤으로 도해 안의 문구가
 * 스크린리더·브라우저 검색·검색엔진에 노출된다 — <img> 속 SVG는 셋 다 불가능했다.
 */
import { getLocale, useTranslations } from '../../i18n/utils';

interface Props {
  /** 도해 안에 표시되는 제목 (SVG의 상단 제목에 해당) */
  title: string;
  /** 캡션에 쓰이는 이름. 지정하지 않으면 title을 쓴다. */
  caption?: string;
  no?: number;
  footer?: string[];
}

const { title, caption, no, footer = [] } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const label = no ? `${t('figure.prefix')} ${no}. ${caption ?? title}` : (caption ?? title);
---

<figure class="dgm">
  <div class="canvas">
    <h3 class="dgm-title">{title}</h3>
    <slot />
    {footer.length > 0 && (
      <div class="dgm-footer">
        {footer.map((line) => <p>{line}</p>)}
      </div>
    )}
  </div>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .dgm {
    margin: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .canvas {
    background: var(--c-surface);
    padding: var(--s-24);
  }
  .dgm-title {
    font-family: var(--f-sans);
    font-size: var(--t-heading-sm);
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 var(--s-16);
    padding-bottom: var(--s-12);
    border-bottom: 1px solid var(--c-border);
  }
  .dgm-footer {
    margin-top: var(--s-24);
    padding-top: var(--s-16);
    border-top: 1px solid var(--c-border);
  }
  .dgm-footer p {
    margin: 0;
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .dgm-footer p + p { margin-top: var(--s-4); }

  figcaption {
    padding: var(--s-12) var(--s-16);
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }

  @media (max-width: 599px) {
    .canvas { padding: var(--s-16); }
  }
</style>
