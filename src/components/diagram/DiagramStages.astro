---
/**
 * DiagramStages — 화살표로 이어지는 단계들과, 화살표 없이 나열되는 하단 띠.
 *
 * 넓은 화면에서는 단계가 가로로 흐르고 화살표가 →, 좁은 화면에서는 세로로 쌓이고
 * 화살표가 ↓ 가 된다. 화살표는 글꼴에 좌우되지 않도록 CSS 보더로 그린다.
 */
type Line = string | { sub: string };
interface Box {
  /** 제목 위 작은 라벨 (STEP 1, 원본 데이터 …) */
  eyebrow?: string;
  title: string;
  accent?: boolean;
  lines: Line[];
}
interface Stage {
  label?: string;
  cols?: number;
  boxes: Box[];
}

interface Props {
  stages: Stage[];
  /** 넓은 화면에서도 단계를 세로로 쌓을지. 좁은 화면은 항상 세로다. */
  flow?: 'row' | 'column';
  band?: { title: string; boxes: Box[] };
  /** 도해 전체를 관통하는 한 줄 */
  note?: { eyebrow?: string; text: string };
}

const { stages, flow = 'row', band, note } = Astro.props;
const isSub = (l: Line): l is { sub: string } => typeof l !== 'string';
---

<div class:list={['flow', flow]}>
  {
    stages.map((stage, i) => (
      <>
        {i > 0 && (
          <div class="arrow-cell" aria-hidden="true">
            <p class="stage-label micro" />
            <div class="arrow-wrap">
              <span class="arrow" />
            </div>
          </div>
        )}
        <section class="stage" style={`--cols: ${stage.cols ?? 1}`}>
          {/* 라벨이 없는 단계도 빈 자리를 둔다 — 없으면 그 단계만 박스가 위로 올라가
              윗변이 어긋나고, 라벨 있는 단계의 제목이 홀로 떠 보인다. */}
          <p class="stage-label micro">{stage.label ?? ''}</p>
          <div class="boxes">
            {stage.boxes.map((box) => (
              <article class:list={['box', { accent: box.accent }]}>
                {box.eyebrow && <p class="eyebrow micro">{box.eyebrow}</p>}
                <h4>{box.title}</h4>
                {box.lines.length > 0 && (
                  <ul>
                    {box.lines.map((line) => (
                      <li class:list={{ sub: isSub(line) }}>
                        {isSub(line) ? line.sub : line}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      </>
    ))
  }
</div>

{
  note && (
    <p class="note">
      {note.eyebrow && <span class="note-eyebrow micro">{note.eyebrow}</span>}
      <span>{note.text}</span>
    </p>
  )
}

{
  band && (
    <section class="band">
      <h4 class="band-title">{band.title}</h4>
      <div class="band-boxes">
        {band.boxes.map((box) => (
          <article class="box compact">
            <h4>{box.title}</h4>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  /* 넓은 화면: 단계가 가로로 흐른다. 단계 폭은 내용량에 비례해 늘어난다. */
  .flow {
    display: flex;
    align-items: stretch;
    gap: var(--s-12);
  }
  .stage {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  /* 4대 연구 축처럼 박스가 여럿인 단계는 더 넓은 지분을 갖는다.
     원본 SVG의 폭 비율(170 : 480 : 228 : 184)에 맞춘 값이다. */
  .stage:has(.boxes > :nth-child(2)) { flex-grow: 2.6; }

  /* 패딩과 보더를 빈 라벨에도 똑같이 준다. 보이는 쪽에만 주면 그 단계의 박스만
     5px 내려가 윗변이 어긋난다 (밑줄을 넣으며 실제로 만들었던 결함). */
  .stage-label {
    margin: 0 0 var(--s-8);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid transparent;
    color: var(--c-muted);
  }
  /* 밑줄이 그 단계의 폭만큼만 그어져 아래 박스 묶음의 머리글임을 드러낸다 —
     없으면 라벨이 홀로 떠 보인다. */
  .stage-label:not(:empty) { border-bottom-color: var(--c-border); }
  /* 빈 라벨도 한 줄 높이를 차지해야 아래 박스들의 윗변이 맞는다 */
  .stage-label:empty::before { content: '\00a0'; }

  .boxes {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--s-12);
    /* start가 아니라 stretch — 단계마다 박스 띠의 아랫변까지 맞춰야
       화살표가 띠의 중앙에 놓인다 (원본 SVG도 전 열이 같은 높이였다). */
    align-content: stretch;
  }

  .box {
    background: var(--c-canvas);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    padding: var(--s-16);
  }
  .eyebrow {
    margin: 0 0 var(--s-4);
    color: var(--c-accent);
  }
  .box:not(.accent) .eyebrow { color: var(--c-muted); }

  .box h4 {
    font-family: var(--f-sans);
    font-size: var(--t-body-sm);
    font-weight: 700;
    letter-spacing: normal;
    line-height: 1.5;
    margin: 0;
    color: var(--c-text);
  }
  .box.accent h4 { color: var(--c-accent); }

  .box ul {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .box li {
    position: relative;
    padding-left: 0.85em;
    line-height: 1.6;
  }
  .box li::before {
    content: '·';
    position: absolute;
    left: 0;
  }
  .box li + li { margin-top: var(--s-4); }
  /* 바로 위 줄의 부연 — 항목이 아니라 설명이므로 글머리를 빼고 들여쓴다 */
  .box li.sub {
    padding-left: 2.1em;
    opacity: 0.8;
  }
  .box li.sub::before { content: '—'; left: 0.85em; }

  /* 화살표는 단계와 같은 라벨 자리를 갖고, 그 아래 박스 띠의 중앙에 놓인다.
     라벨 자리를 빼지 않으면 전체 높이의 중앙에 놓여 박스보다 한참 아래로 내려간다. */
  .arrow-cell {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
  }
  .arrow-wrap {
    flex: 1;
    display: grid;
    place-items: center;
  }

  /* 글꼴 문자 대신 보더로 그려 어떤 환경에서도 같은 모양이 나온다. */
  .arrow {
    width: 22px;
    height: 1px;
    background: #6b7b8a;
    position: relative;
  }
  .arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3.5px;
    border-left: 7px solid #6b7b8a;
    border-block: 4px solid transparent;
  }

  /* 전 단계를 관통하는 한 줄 */
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-8) var(--s-12);
    margin: var(--s-16) 0 0;
    padding: var(--s-12) var(--s-16);
    background: var(--c-canvas);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .note-eyebrow { color: var(--c-accent); }

  /* 하단 띠 — 화살표 없이 나열된다 */
  .band {
    margin-top: var(--s-24);
    padding-top: var(--s-24);
    border-top: 1px solid var(--c-border);
  }
  .band-title {
    font-family: var(--f-sans);
    font-size: var(--t-body);
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 var(--s-12);
  }
  .band-boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--s-8);
  }
  .box.compact { padding: var(--s-12) var(--s-16); }
  .box.compact h4 { font-weight: 500; }

  /* flow="column" — 넓은 화면에서도 세로. 중심에서 갈래로 퍼지는 구조에 쓴다. */
  .flow.column { flex-direction: column; gap: var(--s-8); }
  /* 세로로 쌓이면 윗변을 맞출 이유가 없다 — 빈 라벨 자리는 여백만 만든다 */
  .flow.column .stage-label:empty,
  .flow.column .arrow-cell .stage-label { display: none; }
  .flow.column .stage:has(.boxes > :nth-child(2)) { flex-grow: 1; }
  .flow.column .arrow {
    width: 1px;
    height: 18px;
    margin-inline: auto;
  }
  .flow.column .arrow::after {
    right: -3.5px;
    top: auto;
    bottom: -1px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 7px solid #6b7b8a;
    border-bottom: 0;
  }

  /* 좁은 화면: 단계가 세로로 쌓이고 화살표가 아래를 가리킨다.
     축소가 아니라 재배치다 — 글자 크기는 어느 폭에서도 본문과 같다. */
  @media (max-width: 899px) {
    .flow { flex-direction: column; gap: var(--s-8); }
    .stage:has(.boxes > :nth-child(2)) { flex-grow: 1; }
    .stage-label:empty,
    .arrow-cell .stage-label { display: none; }
    .boxes { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }

    .arrow {
      width: 1px;
      height: 18px;
      margin-inline: auto;
    }
    .arrow::after {
      right: -3.5px;
      top: auto;
      bottom: -1px;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 7px solid #6b7b8a;
      border-bottom: 0;
    }
  }
</style>
