---
/**
 * DiagramFigure — 이 시스템에서 가장 중요한 컴포넌트 (DESIGN.md).
 *
 * 도해는 원본 폭 1280px에 10.5~11px 라벨이 박혀 있다. 이것을 컨테이너 폭에 맞춰
 * 축소하면 라벨이 그 배율만큼 함께 줄어든다 — 2026-08-05 실측:
 *   본문 폭 1092px(배율 0.85) → 8.96px,  모바일 325px(배율 0.25) → 2.67px.
 * 즉 판독 불가의 원인은 "도해가 작다"가 아니라 **원본을 컨테이너에 우겨넣어 축소한다**는 데 있다.
 *
 * 그래서 축소를 금지한다. 폭이 모자라면 줄이는 대신 가로로 스크롤한다(min-width = 원본 폭).
 * 넓은 화면에서는 반대로 본문 컬럼 밖으로 빼 원본보다 크게 띄운다.
 */
import { getLocale, useTranslations } from '../i18n/utils';

interface Props {
  src: string;
  alt: string;
  caption: string;
  /** 캡션 번호. 지정하면 `圖 N.` 접두가 붙는다. */
  no?: number;
  width: number;
  height: number;
}

const { src, alt, caption, no, width, height } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const label = no ? `${t('figure.prefix')} ${no}. ${caption}` : caption;
---

<figure class="diagram" style={`--dgm-native: ${width}px`}>
  <div class="viewport">
    <div class="scroller" data-dgm-scroller>
      <button class="frame" type="button" data-diagram-src={src} data-diagram-alt={alt}>
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      </button>
    </div>
    <span class="zoom" aria-hidden="true">＋</span>
  </div>
  <figcaption>
    {label}
    <span class="hint">{` — ${t('figure.zoom')}`}</span>
    <span class="hint pan" data-dgm-pan hidden>{` · ${t('figure.pan')}`}</span>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    /* 그림자 없음 — 시스템은 플랫하다 (DESIGN.md) */
  }

  /* 넓은 화면에서는 도해만 본문 컬럼(1092px) 밖으로 빼 축소를 되돌린다.
     1200px 미만에서는 브레이크아웃해도 원본 폭에 못 미쳐 이득이 없으므로 적용하지 않는다.
     64px 거터의 절반은 세로 스크롤바 몫이다 — 100vw는 스크롤바를 포함하는데
     레이아웃 폭은 그렇지 않아, 이 여유가 없으면 좌우 여백이 8px까지 좁아진다. */
  @media (min-width: 1200px) {
    .diagram {
      --dgm-bleed: min(1440px, 100vw - 64px);
      width: var(--dgm-bleed);
      margin-inline: calc((100% - var(--dgm-bleed)) / 2);
    }
  }

  .viewport { position: relative; }

  .scroller {
    overflow-x: auto;
    overflow-y: hidden;
    /* 도해를 끝까지 밀었을 때 페이지가 따라 움직이지 않게 한다 */
    overscroll-behavior-x: contain;
  }
  .scroller:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }

  .frame {
    display: block;
    width: 100%;
    /* 판독 하한. 컨테이너가 좁아도 원본 아래로는 절대 줄이지 않는다. */
    min-width: var(--dgm-native);
    padding: 0;
    border: 0;
    /* 다이어그램은 시스템 팔레트로 재제작한다 (2026-08-03 개정).
       흰 배경을 강제하면 재색조 가능한 SVG까지 액자에 갇힌다. */
    background: var(--c-surface);
    cursor: zoom-in;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zoom {
    position: absolute;
    right: var(--s-12);
    bottom: var(--s-12);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--c-canvas);
    color: var(--c-accent);
    /* 아이콘 글리프다 — 본문 스케일에 묶지 않는다 */
    font-size: 16px;
    line-height: 1;
    pointer-events: none;
  }

  figcaption {
    padding: var(--s-12) var(--s-16);
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .hint { color: var(--c-accent); }

  /* 인쇄본에서는 잘리는 대신 폭에 맞춘다 — 심사 자료로 출력되는 경우가 있다 */
  @media print {
    .diagram { width: 100%; margin-inline: 0; }
    .scroller { overflow: visible; }
    .frame { min-width: 0; }
    .zoom { display: none; }
  }
</style>

<script>
  // 페이지당 하나의 <dialog>를 공유한다. <dialog>를 쓰는 이유는 Esc 닫기와
  // 포커스 트랩이 브라우저 기본 동작으로 제공되기 때문이다.
  const dialog = document.createElement('dialog');
  dialog.className = 'diagram-lightbox';
  dialog.innerHTML = '<img alt="">';
  document.body.append(dialog);

  const img = dialog.querySelector('img')!;

  // 스크롤 가능한 영역은 키보드로도 스크롤할 수 있어야 한다(WCAG 2.1.1).
  // 다만 스크롤할 것이 없을 때 tabindex를 남기면 죽은 탭 스톱이 되므로 폭에 따라 붙였다 뗀다.
  const scrollers = [...document.querySelectorAll<HTMLElement>('[data-dgm-scroller]')];

  function sync(el: HTMLElement) {
    const fig = el.closest<HTMLElement>('.diagram')!;
    const pan = fig.querySelector<HTMLElement>('[data-dgm-pan]');
    const scrollable = el.scrollWidth - el.clientWidth > 1;

    // 스크롤할 것이 없으면 tabindex를 떼어 죽은 탭 스톱을 남기지 않는다.
    if (scrollable) {
      el.tabIndex = 0;
      el.setAttribute('role', 'group');
    } else {
      el.removeAttribute('tabindex');
      el.removeAttribute('role');
    }
    if (pan) pan.hidden = !scrollable;
  }

  // 관찰자를 변수에 담아 둔다. 인스턴스를 어디서도 참조하지 않으면 수거될 수 있어
  // 리사이즈 후 상태가 갱신되지 않는다 (실측: 데스크톱 → 모바일 전환 시 tabindex 누락).
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) sync(entry.target as HTMLElement);
  });

  for (const el of scrollers) {
    sync(el);
    observer.observe(el);
  }

  // 가로로 밀다가 손을 떼면 확대가 열리는 것을 막는다 — 스크롤과 클릭이 같은 영역을 공유한다.
  let panned = false;
  let startX = 0;
  document.addEventListener('pointerdown', (e) => {
    panned = false;
    startX = e.clientX;
  });
  document.addEventListener('pointermove', (e) => {
    if (e.buttons && Math.abs(e.clientX - startX) > 6) panned = true;
  });

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-diagram-src]');
    if (trigger) {
      if (panned) return;
      img.src = trigger.dataset.diagramSrc!;
      img.alt = trigger.dataset.diagramAlt ?? '';
      dialog.showModal();
      return;
    }
    // 백드롭 클릭과 이미지 클릭 양쪽으로 닫는다. Esc는 <dialog> 기본 동작.
    if (panned) return;
    if (event.target === dialog || event.target === img) dialog.close();
  });
</script>

<style is:global>
  .diagram-lightbox {
    border: 0;
    padding: 0;
    max-width: 96vw;
    max-height: 96vh;
    background: transparent;
    /* 확대본이 화면보다 크므로 다이얼로그 자신이 스크롤을 맡는다 */
    overflow: auto;
    overscroll-behavior: contain;
  }
  .diagram-lightbox::backdrop {
    background: rgb(11 14 17 / 0.92);
  }
  /* 확대가 실제로 확대여야 한다. 이전 규칙(width:auto + max-width:96vw)은 도해를
     고유 폭 1280px로 묶어, 모바일에서는 인라인 대비 1.11배(325→360px)에 그쳤고
     브레이크아웃 적용 후 데스크톱에서는 인라인(최대 1440px)보다 오히려 작아졌다. */
  .diagram-lightbox img {
    display: block;
    width: max(96vw, 1600px);
    max-width: none;
    height: auto;
    background: var(--c-surface);
    border-radius: var(--radius-card);
    cursor: zoom-out;
  }
</style>
