---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale, useTranslations, alternatePath, otherLocale } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const pageTitle = title ? `${title} — CHIC` : t('site.title');
const pageDesc = description ?? t('site.desc');
const altHref = alternatePath(Astro.url, otherLocale(locale));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={new URL(altHref, Astro.site)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />

    <!-- TODO(M-09): Noto Serif KR 한글 자족은 용량이 크다. 배포 전 서브셋 자체호스팅으로 교체 (DESIGN.md) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600&family=Playfair+Display:wght@500&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
