---
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Locale } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import { formatDate } from '../../../i18n/date';

// 컬렉션 id가 `<locale>/<slug>` 이므로 언어와 슬러그를 함께 뽑아낸다.
export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => {
    const [locale, ...rest] = post.id.split('/');
    return { params: { locale, slug: rest.join('/') }, props: { post } };
  });
}

const { post } = Astro.props;
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const { Content } = await render(post);
const date = formatDate(post.data.date, locale);
---

<BaseLayout title={post.data.title}>
  <article class="wrap block">
    <p class="meta micro">
      {date ?? t('news.nodate')}
    </p>
    <h1>{post.data.title}</h1>

    {
      (post.data.when || post.data.where) && (
        <p class="where">
          {post.data.when}
          {post.data.when && post.data.where && ' · '}
          {post.data.where}
        </p>
      )
    }

    {
      post.data.image && (
        <img class="hero-img" src={withBase(post.data.image)} alt={post.data.title} loading="lazy" decoding="async" />
      )
    }

    <div class="body measure">
      <Content />
    </div>

    {
      post.data.links.length > 0 && (
        <section class="links">
          <h2 class="micro">{t('news.attachments')}</h2>
          <ul>
            {post.data.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="back">
      <a href={withBase(`/${locale}/news/`)}>← {t('news.back')}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .block { padding-block: var(--s-72); }
  .meta { margin: 0; color: var(--c-accent); }
  h1 {
    font-size: var(--t-heading);
    line-height: 1.3;
    margin: var(--s-12) 0;
    max-width: 24ch;
  }
  .where { margin: 0 0 var(--s-32); color: var(--c-muted); font-size: var(--t-body-sm); }
  .hero-img {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    margin: 0 0 var(--s-32);
  }
  .body :global(p) { margin: 0 0 var(--s-16); }

  .links {
    margin-top: var(--s-48);
    border-top: 1px solid var(--c-border);
    padding-top: var(--s-24);
  }
  .links h2 { margin: 0 0 var(--s-16); font-family: var(--f-sans); font-weight: 400; }
  .links ul { list-style: none; margin: 0; padding: 0; }
  .links li + li { margin-top: var(--s-12); }
  /* News 첨부는 전부 외부 링크다 — 외부임이 보여야 한다 (DESIGN.md) */
  .links a {
    color: var(--c-accent-2);
    text-decoration: none;
    font-size: var(--t-body-sm);
  }
  .links a:hover { text-decoration: underline; }

  .back { margin-top: var(--s-72); }
  .back a { color: var(--c-accent); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
</style>
