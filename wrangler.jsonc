{
  // Cloudflare Workers 정적 자산 배포 설정.
  //
  // 이 파일이 없으면 `wrangler deploy`가 자동 구성(auto-config)을 돌려
  // `astro add cloudflare`로 어댑터를 붙인다. 그러면 정적 사이트가 서버 렌더링
  // 모드로 재빌드되고, Workers 런타임에 없는 node:fs를 content.config가 부르면서
  // 빌드가 실패한다 (2026-08-05 실측). 설정을 명시해 자동 구성을 막는다.
  //
  // `main`(워커 스크립트)을 두지 않는다 — 순수 정적 배포이므로 실행할 코드가 없다.
  "name": "chic-homepage",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    // 없는 경로는 Astro가 생성한 404 페이지로 보낸다.
    // "single-page-application"은 다중 페이지 사이트에서 오답이다.
    "not_found_handling": "404-page"
  }
}
